<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
  <tlib-version>1.0</tlib-version>
  <short-name>hostel</short-name>
  <uri>http://hostel.local/functions</uri>
  <function>
    <name>dateTime</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>java.lang.String dateTime(java.time.LocalDateTime)</function-signature>
  </function>
  <function>
    <name>date</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>java.lang.String date(java.time.temporal.TemporalAccessor)</function-signature>
  </function>
  <function>
    <name>hours</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>java.lang.String hours(java.lang.Double)</function-signature>
  </function>
  <function>
    <name>squares</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>java.lang.String squares(java.lang.Number, int)</function-signature>
  </function>
  <function>
    <name>percent</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>int percent(long, long)</function-signature>
  </function>
  <function>
    <name>initial</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>java.lang.String initial(java.lang.String)</function-signature>
  </function>
  <function>
    <name>maxMonthlyCount</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>long maxMonthlyCount(java.util.List)</function-signature>
  </function>
  <function>
    <name>lowestRated</name>
    <function-class>com.hostel.util.ViewFunctions</function-class>
    <function-signature>com.hostel.report.CategoryStat lowestRated(java.util.List)</function-signature>
  </function>
</taglib>
